# Copy to .env and fill in. All agents call AWS Bedrock.

# --- AWS Bedrock (required for all benchmarks) ---
# Provide credentials via `aws configure` or the standard AWS_* variables.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2

# Bedrock client tuning (optional; defaults shown)
BEDROCK_RETRY_MAX_ATTEMPTS=15
BEDROCK_READ_TIMEOUT_SEC=600
BEDROCK_CONNECT_TIMEOUT_SEC=30

# --- MCP-Atlas evaluation judge (optional) ---
# true: LiteLLM with Gemini 2.5 Pro (official default). false: fall back to Bedrock.
EVAL_USE_LITELLM=true
# Required only when EVAL_USE_LITELLM=true and using Gemini:
GEMINI_API_KEY=
# Per-server MCP API keys live in their own file referenced by MCP_ENV_FILE
# (one NAME=VALUE per line, e.g. GITHUB_TOKEN=..., AIRTABLE_TOKEN=...).
MCP_ENV_FILE=

# --- SkillsBench (optional) ---
# Use a local clone instead of auto-bootstrapping from GitHub.
SKILLBENCH_REPO_DIR=

# --- Experiment orchestration (examples/harness-evolution) ---
# Path to this repository (used by run_exp*.py to locate benchmark runners).
AEVOLVE_V3_DIR=
