# Adaptive Auto-Harness — environment configuration template.
#
# Copy this file to `.env` and fill in the values that apply to your
# setup. The framework reads `.env` automatically. See INSTALL.md.

# ---------- Model IDs (required) ----------
# These are referenced by the placeholders <solver-model-id> /
# <evolver-model-id> throughout the configs and code.
SOLVER_MODEL=
EVOLVER_MODEL=

# ---------- LLM provider credentials (one of) ----------
# AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# OpenAI
OPENAI_API_KEY=

# LiteLLM (provider-specific; see https://docs.litellm.ai/)

# ---------- FutureX live-mode retrieval (optional) ----------
TAVILY_API_KEY=
FRED_API_KEY=
SERPER_API_KEY=
JINA_API_KEY=
EXA_API_KEY=
